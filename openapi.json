{
  "openapi": "3.1.0",
  "info": {
    "title": "Photos (Wizard page API)",
    "version": "0.4.0",
    "description": "The Wizard page's own API at /photos/api. Same-origin, owner's shell origins only. Immich's API (https://api.immich.app) is served unchanged at /api on the same port."
  },
  "paths": {
    "/photos/api/status": {
      "get": {
        "summary": "Immich, agent, library, background work and import status",
        "responses": {
          "200": {
            "description": "status"
          }
        }
      }
    },
    "/photos/api/import": {
      "get": {
        "summary": "Takeout import state, files in the drop folder, options, log tail",
        "responses": {
          "200": {
            "description": "import"
          }
        }
      }
    },
    "/photos/api/import/options": {
      "get": {
        "summary": "Import options",
        "responses": {
          "200": {
            "description": "options"
          }
        }
      },
      "post": {
        "summary": "Change import options",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "include_archived": {
                    "type": "boolean"
                  },
                  "include_partner": {
                    "type": "boolean"
                  },
                  "sync_albums": {
                    "type": "boolean"
                  },
                  "include_trashed": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "options"
          }
        }
      }
    },
    "/photos/api/import/start": {
      "post": {
        "summary": "Start importing every Takeout file in Photos/Import",
        "responses": {
          "200": {
            "description": "started or why not"
          }
        }
      }
    },
    "/photos/api/print-review": {
      "get": {
        "summary": "Read the previous month's grandparent print review",
        "parameters": [
          {
            "name": "month",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "review"
          }
        }
      }
    },
    "/photos/api/print-review/generate": {
      "post": {
        "summary": "Generate a suggested monthly shortlist",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "month": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
                  "limit": {"type": "integer", "minimum": 1, "maximum": 20, "default": 8}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "draft review"
          },
          "400": {
            "description": "invalid input"
          },
          "403": {
            "description": "owner only"
          },
          "404": {
            "description": "feature is off"
          }
        }
      }
    },
    "/photos/api/print-review/save": {
      "post": {
        "summary": "Save selected candidate ids and the month note",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["asset_ids"],
                "properties": {
                  "month": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
                  "asset_ids": {"type": "array", "minItems": 1, "maxItems": 20,
                    "items": {"type": "string", "format": "uuid"}},
                  "note": {"type": "string", "maxLength": 500}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "draft review"
          },
          "400": {
            "description": "invalid input"
          },
          "403": {
            "description": "owner only"
          },
          "404": {
            "description": "feature is off"
          }
        }
      }
    },
    "/photos/api/print-review/approve": {
      "post": {
        "summary": "Preview or explicitly approve the exact print set; never places an order",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["confirmed"],
                "properties": {
                  "month": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
                  "confirmed": {"type": "boolean"},
                  "expected_count": {"type": "integer", "minimum": 1, "maximum": 20},
                  "expected_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "approval preview or approved review"
          },
          "400": {
            "description": "invalid input, changed review or stale approval preview"
          },
          "403": {
            "description": "owner only"
          },
          "404": {
            "description": "feature is off"
          }
        }
      }
    },
    "/photos/api/print-review/thumbnail/{assetId}": {
      "get": {
        "summary": "Owner-only thumbnail for a review candidate",
        "parameters": [
          {
            "name": "assetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "month",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "JPEG thumbnail"
          },
          "403": {
            "description": "owner only"
          },
          "404": {
            "description": "not a candidate in this review or feature is off"
          }
        }
      }
    },
    "/api/switches": {
      "get": {
        "summary": "wizard.app-switches/1",
        "responses": {
          "200": {
            "description": "switches"
          }
        }
      },
      "post": {
        "summary": "Set a switch",
        "responses": {
          "200": {
            "description": "switches"
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Front health and whether Immich answers",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    }
  }
}
