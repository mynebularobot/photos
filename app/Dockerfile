FROM python:3.12-alpine@sha256:1b668429b3511ab407d8e00648891631b0b1a4d7e15e3ca70f38ab5b91ad4ab4
# Used only by `wam verify` (the installed app runs the same program inlined in runtipi/docker-compose.yml on the
# same stock image, with no build). app/front.py is generated by mcp/inline.py.
COPY app/front.py /app/front.py
RUN mkdir -p /data /import /library
ENV STATE_DIR=/data IMPORT_DIR=/import LIBRARY_DIR=/library WIZARD_APP=photos APP_VERSION=0.4.0 \
    UPSTREAM_HOST=photos-server UPSTREAM_PORT=2283 PYTHONDONTWRITEBYTECODE=1
EXPOSE 8799
CMD ["python", "/app/front.py"]
